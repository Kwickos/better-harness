#!/bin/sh
# Ce dépôt ne se publie que sous le compte GitHub Kwickos : remote Kwickos, commits signés Kwickos.
# Activé par `git config core.hooksPath .githooks`.

OWNER="Kwickos"
EMAIL="Kwickos@users.noreply.github.com"
url="$2"

case "$url" in
  *github.com[:/]"$OWNER"/*) ;;
  *) echo "pre-push : $url n'appartient pas à $OWNER, push refusé." >&2; exit 1 ;;
esac

if command -v gh >/dev/null 2>&1; then
  login=$(gh api user --jq .login 2>/dev/null)
  if [ -n "$login" ] && [ "$login" != "$OWNER" ]; then
    echo "pre-push : gh est connecté en « $login » (gh auth switch -u $OWNER), push refusé." >&2
    exit 1
  fi
fi

zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  # shellcheck disable=SC2086
  bad=$(git log --format='%h %an <%ae> / %cn <%ce>' $range | grep -v " $OWNER <$EMAIL> / $OWNER <$EMAIL>$")
  if [ -n "$bad" ]; then
    echo "pre-push : ces commits ne sont pas signés $OWNER <$EMAIL> :" >&2
    echo "$bad" >&2
    exit 1
  fi
done
exit 0
