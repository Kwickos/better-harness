{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Better Harness",
  "version": "0.3.0",
  "identifier": "dev.betterharness.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Better Harness",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "visible": false,
        "hiddenTitle": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; media-src asset: http://asset.localhost; frame-src asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; media-src asset: http://asset.localhost; frame-src asset: http://asset.localhost; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "externalBin": [
      "binaries/sim-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFNDIxQjJDNzUzODA3MzcKUldRM0J6aDFMQnRDenZQQk5yWGhOeWR4R0tkcU9RUm96QTd1bCtvenFQY0tJV1haK0I0aVJSM2MK",
      "endpoints": [
        "https://github.com/Kwickos/better-harness/releases/latest/download/latest.json"
      ]
    }
  }
}
